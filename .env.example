# Configure these in Vercel Project Settings > Environment Variables.
# Do not put real values into this example or commit an actual .env file.
APP_BASE_URL=https://your-project.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=GENERATE_A_RANDOM_SECRET
TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_WEB_OAUTH_CLIENT_SECRET
